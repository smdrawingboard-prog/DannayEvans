# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Signature engine ────────────────────────────────────────────────────────
# 'sealed' is the built-in engine. Set this to the key you register in
# lib/signatures/index.ts when you plug in your own signature application.
SIGNATURE_PROVIDER=sealed

# Only needed when SIGNATURE_PROVIDER=pandadoc
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_SECRET=

# ─── Messaging (server-side only) ────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
SENDGRID_API_KEY=
MAIL_FROM=no-reply@example.com

# ─── Sourcing and CRM connectors (server-side only) ──────────────────────────
APIFY_API_TOKEN=
LINKEDIN_ACCESS_TOKEN=
HUBSPOT_TOKEN=
PIPEDRIVE_TOKEN=
SALESFORCE_TOKEN=
SALESFORCE_URL=
BULLHORN_CLIENT_ID=
BULLHORN_CLIENT_SECRET=
